# ==============================================================================
# AETHER LUXURY 3D E-COMMERCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Shopify Storefront GraphQL API Credentials
# Replace with your actual Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API Access Token (created in Shopify Headless sales channel)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here

# Supported API version (e.g., 2024-07)
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Base canonical deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3D WebGL Feature Flag
NEXT_PUBLIC_ENABLE_3D=true
